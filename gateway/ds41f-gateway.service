[Unit]
Description=DS41F production gateway with durable vision jobs
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
DynamicUser=yes
WorkingDirectory=/srv/ds41f-gateway
EnvironmentFile=/etc/ds41f-gateway.env
Environment=DS41F_GATEWAY_STATE_DIR=/var/lib/ds41f-gateway
Environment=DGX_MEDIA_SERIAL_REQUESTS=1
Environment=DGX_MEDIA_MAX_CONCURRENCY=2
Environment=DS41F_RECIPE_VERSION=1.2.6
Environment=DGX_VISION_CONTROL_ENABLED=1
Environment=DGX_VISION_REASONING_EFFORT=max
Environment=DGX_VISION_THINKING_BUDGET=8192
Environment=DGX_VISION_FINAL_ANSWER_TOKENS=32768
Environment=DGX_VISION_JOB_TIMEOUT_SECONDS=3590
Environment=DGX_VISION_QUEUE_TIMEOUT_SECONDS=1800
Environment=DGX_VISION_CANCEL_GRACE_SECONDS=60
StateDirectory=ds41f-gateway
StateDirectoryMode=0700
UMask=0077
ExecStart=/srv/ds41f-gateway/.venv/bin/ds41f-gateway
Restart=on-failure
RestartSec=5
TimeoutStopSec=60
MemoryMax=1G
MemorySwapMax=0
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
