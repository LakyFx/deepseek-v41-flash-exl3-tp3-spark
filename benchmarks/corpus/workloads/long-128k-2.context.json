ol:\n        return True\n\n    @classmethod\n    def supports_combination(\n        cls,\n        head_size: int,\n        dtype: torch.dtype,\n        kv_cache_dtype: CacheDType | None,\n        block_size: int | None,\n        use_mla: bool,\n        has_sink: bool,\n        use_sparse: bool,\n        use_mm_prefix: bool,\n        device_capability: DeviceCapability,\n    ) -> str | None:\n        # FlashInfer MLA kernel requires qk_nope_head_dim in [64, 128, 192]\n        vllm_config = get_current_vllm_config()\n        if vllm_config.model_config is not None:\n            hf_text_config = vllm_config.model_config.hf_text_config\n            qk_nope_head_dim = getattr(hf_text_config, \"qk_nope_head_dim\", 1)\n            if qk_nope_head_dim not in [64, 128, 192]:\n                return (\n                    \"FlashInfer MLA kernel requires qk_nope_head_dim \"\n                    f\"in [64, 128, 192], but got {qk_nope_head_dim}\"\n                )\n        return None\n\n```\n\n\nReference unit vllm/model_executor/layers/sparse_attn_indexer.py:779:sparse_attn_indexer_fake\n```python\ndef sparse_attn_indexer_fake(\n    hidden_states: torch.Tensor,\n    k_cache_prefix: LayerNameType,\n    kv_cache: torch.Tensor,\n    q_quant: torch.Tensor,\n    q_scale: torch.Tensor | None,\n    k: torch.Tensor | None,\n    weights: torch.Tensor,\n    quant_block_size: int,\n    scale_fmt: str | None,\n    topk_tokens: int,\n    head_dim: int,\n    max_model_len: int,\n    total_seq_lens: int,\n    topk_indices_buffer: torch.Tensor | None,\n    skip_k_cache_insert: bool,\n    use_pcp: bool,\n    dense_mha_metadata_layer_name: LayerNameType,\n    use_fp4_cache: bool = False,\n    dcp_rank: int = 0,\n    dcp_world_size: int = 1,\n    cp_kv_cache_interleave_size: int = 1,\n    skip_topk_buffer_clear: bool = False,\n    candidate_blocks: torch.Tensor | None = None,\n    candidate_block_size: int = 0,\n    candidate_write: bool = False,\n) -> torch.Tensor:\n    return topk_indices_b